        <result property="personalProjectMargin" column="personal_project_margin" />
        <result property="personalProjectProfit" column="personal_project_profit" />
        <result property="teamProjectId" column="team_project_id" />
        <result property="teamProjectRevenue" column="team_project_revenue" />
        <result property="teamProjectMargin" column="team_project_margin" />
        <result property="teamProjectProfit" column="team_project_profit" />
        <result property="teamMemberCount" column="team_member_count" />
        <result property="kpiScores" column="kpi_scores" />
        <result property="performanceRemark" column="performance_remark" />
        <result property="status" column="status" />
        <result property="delflag" column="delflag" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
        <result property="createdBy" column="created_by" />
        <result property="updatedBy" column="updated_by" />
        <result property="tenantId" column="tenant_id" />
    </resultMap>

    <!-- 目前所有查询均可用MyBatis-Plus Wrapper实现，无需自定义SQL。若后续有复杂统计、批量操作等需求可在此扩展。 -->

