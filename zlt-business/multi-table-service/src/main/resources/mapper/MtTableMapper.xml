<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.central.multitable.mapper.MtTableMapper">

    <resultMap id="BaseResultMap" type="com.central.multitable.model.MtTable">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="tenant_id" property="tenantId" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="team_id" property="teamId" jdbcType="BIGINT"/>
        <result column="icon" property="icon" jdbcType="VARCHAR"/>
        <result column="color" property="color" jdbcType="VARCHAR"/>
        <result column="created_by" property="createdBy" jdbcType="BIGINT"/>
        <result column="is_deleted" property="isDeleted" jdbcType="TINYINT"/>
        <result column="deleted_at" property="deletedAt" jdbcType="TIMESTAMP"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, name, description, team_id, icon, color, 
        created_by, is_deleted, deleted_at, created_at, updated_at
    </sql>

    <select id="findList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mt_table
        WHERE is_deleted = 0
        <if test="params.name != null and params.name != ''">
            AND name LIKE CONCAT('%', #{params.name}, '%')
        </if>
        <if test="params.teamId != null">
            AND team_id = #{params.teamId}
        </if>
        <if test="params.tenantId != null">
            AND tenant_id = #{params.tenantId}
        </if>
        ORDER BY created_at DESC
    </select>

    <select id="findByTeamId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mt_table
        WHERE team_id = #{teamId} AND is_deleted = 0
        ORDER BY created_at DESC
    </select>

    <select id="findByTenantId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mt_table
        WHERE tenant_id = #{tenantId} AND is_deleted = 0
        ORDER BY created_at DESC
    </select>

    <update id="deleteLogically">
        UPDATE mt_table 
        SET is_deleted = 1, deleted_at = NOW()
        WHERE id = #{id}
    </update>

</mapper>