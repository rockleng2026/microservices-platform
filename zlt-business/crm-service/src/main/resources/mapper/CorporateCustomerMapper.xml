<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.central.crm.mapper.CorporateCustomerMapper">

    <!-- 根据客户ID查询企业客户扩展信息 -->
    <select id="selectByCustomerId" resultType="com.central.crm.model.CorporateCustomer">
        SELECT * FROM corporate_customer 
        WHERE customer_id = #{customerId}
    </select>

    <!-- 根据统一社会信用代码查询企业客户扩展信息 -->
    <select id="selectByCreditCode" resultType="com.central.crm.model.CorporateCustomer">
        SELECT * FROM corporate_customer 
        WHERE credit_code = #{creditCode}
    </select>

</mapper> 