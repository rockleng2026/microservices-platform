<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.central.multitable.mapper.MtTableMapper">

    <resultMap id="BaseResultMap" type="com.central.multitable.model.MtTable">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="tenant_id" property="tenantId" jdbcType="VARCHAR"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="team_id" property="teamId" jdbcType="BIGINT"/>
        <result column="icon" property="icon" jdbcType="VARCHAR"/>
        <result column="color" property="color" jdbcType="VARCHAR"/>
        <result column="created_by" property="createdBy" jdbcType="BIGINT"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="created_at" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, name, description, team_id, icon, color, 
        created_by, status, created_at, updated_at
    </sql>

    <select id="findList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mt_table
        WHERE status = 1
        <if test="query.name != null and query.name != ''">
            AND name LIKE CONCAT('%', #{query.name}, '%')
        </if>
        <if test="query.teamId != null">
            AND team_id = #{query.teamId}
        </if>
        <if test="query.createdBy != null">
            AND created_by = #{query.createdBy}
        </if>
        <choose>
            <when test="query.orderBy != null and query.orderBy != ''">
                <choose>
                    <when test="query.orderDirection != null and query.orderDirection.toLowerCase() == 'asc'">
                        ORDER BY ${query.orderBy} ASC
                    </when>
                    <otherwise>
                        ORDER BY ${query.orderBy} DESC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY updated_at DESC
            </otherwise>
        </choose>
    </select>

    <select id="findByTeamId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mt_table
        WHERE team_id = #{teamId} AND status = 1
        ORDER BY updated_at DESC
    </select>

    <select id="findByTenantId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mt_table
        WHERE tenant_id = #{tenantId} AND status = 1
        ORDER BY updated_at DESC
    </select>

    <update id="deleteLogically">
        UPDATE mt_table 
        SET status = 0, updated_at = NOW()
        WHERE id = #{id}
    </update>

</mapper>